# ── GigTrotter environment ──────────────────────────────────────────────
# Copy to `.env.local` and fill in. Never commit `.env.local`.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by Edge Functions / inbound webhook. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — powers the vision parsing pipeline (phase 2+)
ANTHROPIC_API_KEY=sk-ant-...
# Model used for capture parsing. Vision-capable.
ANTHROPIC_PARSE_MODEL=claude-sonnet-4-6

# Mapbox (Account → Tokens) — the Travel Board globe
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# Inbound email forwarding (phase 2). Resend or Postmark inbound webhook.
# Shared secret the webhook must present in the `x-webhook-secret` header.
INBOUND_WEBHOOK_SECRET=generate-a-long-random-string
# The domain user forwarding addresses live on, e.g. capture.gigtrotter.com
FORWARDING_DOMAIN=capture.gigtrotter.example

# Per-user capture encryption. 32-byte base64 master key (envelope encryption).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CAPTURE_MASTER_KEY=base64-32-bytes

# Observability (optional in dev)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Public site URL — used for anon board links + OAuth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
