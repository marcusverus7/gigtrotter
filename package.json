{
  "name": "gigtrotter",
  "version": "0.1.0",
  "private": true,
  "description": "The wallet that remembers \u2014 a capture-first ticket & travel wallet that builds a private life map automatically.",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "eval": "tsx --tsconfig eval/tsconfig.json eval/run.ts",
    "test:logic": "tsx --tsconfig eval/tsconfig.json eval/logic.test.ts",
    "check:rls": "node scripts/check-service-role-writes.mjs",
    "test:ticketing": "tsx --tsconfig eval/tsconfig.json eval/ticketing.test.ts",
    "test:entry": "tsx --tsconfig eval/tsconfig.json eval/entry.test.ts",
    "test:capture": "tsx --tsconfig eval/tsconfig.json eval/capture.test.ts",
    "test:db": "tsx --tsconfig eval/tsconfig.json eval/db.test.ts",
    "test": "pnpm test:logic && pnpm test:ticketing && pnpm test:entry && pnpm test:capture",
    "eval:real": "tsx --tsconfig eval/tsconfig.json eval/score-real.ts",
    "staging:migrate": "node scripts/staging-migrate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.15.0",
    "geist": "^1.3.1",
    "lucide-react": "^0.469.0",
    "mapbox-gl": "^3.9.2",
    "next": "^15.5.28",
    "posthog-js": "^1.203.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "stripe": "^23.1.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.171.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.171.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8.4.49",
    "postgres": "^4.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.0.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "*"
    ]
  }
}
